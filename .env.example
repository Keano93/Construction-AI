# Copy to .env. Never commit real keys.
# Claude API key: when set (and NOTICE_LLM_PROVIDER=auto), agents use Claude; otherwise the offline rules provider.
ANTHROPIC_API_KEY=
NOTICE_LLM_PROVIDER=auto            # auto | claude | offline
NOTICE_CLAUDE_MODEL=claude-opus-5-5
NOTICE_CLAUDE_EFFORT=medium         # low | medium | high | xhigh | max
NOTICE_CLAUDE_SERVER_FALLBACKS=true # server-side refusal fallback
NOTICE_SECRET_KEY=change-me-to-a-long-random-string
NOTICE_LOW_CONFIDENCE_THRESHOLD=0.7
# For local (non-docker) dev:
# NOTICE_DATABASE_URL=postgresql+psycopg://notice:notice@localhost:5432/notice
